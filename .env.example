# Copy to .env.local and fill in.

# Supabase project (Project Settings -> API). Use the SERVICE ROLE key, not
# the anon key -- this app has no per-user auth, so all DB access happens
# server-side only, and this key must never be exposed to the browser
# (never prefix it with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login. ADMIN_PASSCODE is what you type into the "Admin access"
# prompt (reached by tapping the landing page title 5x). ADMIN_SESSION_SECRET
# signs the admin session cookie -- generate a random one with:
#   openssl rand -hex 32
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=

# Regular-season score syncing (see lib/syncScores.ts). BALLDONTLIE_API_KEY
# comes from https://app.balldontlie.io (free account). CRON_SECRET is a
# random value -- generate the same way as ADMIN_SESSION_SECRET -- that
# Vercel automatically sends when it triggers the nightly cron; without it
# set, /api/sync-scores only accepts requests from a logged-in admin.
BALLDONTLIE_API_KEY=
CRON_SECRET=
